# Copy this file to .env and fill in your real key.
# Never commit your actual .env file to GitHub.

# Free, no credit card required — get yours at https://console.groq.com/keys
# This single key powers both the chat replies (Llama 3.3) and the speech
# transcription (Whisper large-v3), so it's the only external key you need.
GROQ_API_KEY=gsk_your-key-here
# Groq chat model (change if Groq retires it)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Runtime mode: development | production
ENVIRONMENT=development

# Secret used to sign staff login tokens. Set this to any long random string
# (32+ characters) before a real deployment — the default is fine for local
# development only. Generate one quickly with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-random-32-plus-character-string

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long an issued session token stays valid.
TOKEN_TTL_HOURS=12

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Google Sign-In for staff ---
# 1. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
#    client ID -> type "Web application".
# 2. Add your frontend origin (e.g. http://localhost:5173) under
#    "Authorized JavaScript origins". No redirect URI is needed — Google
#    Identity Services uses the JS SDK, not a redirect flow — and there is
#    no client *secret* to configure; the ID-token flow doesn't use one.
# 3. Put the SAME client ID here AND in frontend/.env as VITE_GOOGLE_CLIENT_ID.
# Leave blank to disable Google sign-in entirely.
GOOGLE_CLIENT_ID=

# Optional defense-in-depth: only accept Google accounts on this email
# domain, e.g. bolobank.co.in. Leave blank to skip this check — the
# per-employee allowlist below is the primary access control.
GOOGLE_ALLOWED_DOMAIN=

# REQUIRED for Google sign-in to accept anyone: comma-separated list of
# employee email addresses authorized for BoloBank staff access. Each email
# listed here gets a Staff record created automatically on server startup;
# an employee's Google account is bound to that record the first time they
# sign in. Emails NOT in this list are always rejected, even with a
# perfectly valid Google token — signing in with Google never creates a new
# staff account on its own.
#   Example: AUTHORIZED_EMPLOYEE_EMAILS=priya.sharma@bolobank.co.in,ravi.kumar@bolobank.co.in
AUTHORIZED_EMPLOYEE_EMAILS=

# Optional local/demo password login. Disabled by default.
# Enable ONLY for local development or a controlled hackathon demo.
ENABLE_PASSWORD_LOGIN=false
SEED_DEMO_STAFF=false
# If both are true, a demo account is seeded: staff / bolobank123.
# Never enable SEED_DEMO_STAFF in production.

# Optional: override the SQLite database file path (used by the test suite
# to run against an isolated temp database instead of bolobank.db).
DATABASE_PATH=

# --- Daily scheme updates (Staff Portal -> Schemes) ---
# Check the announcement feed at startup and then every N hours. New schemes
# become drafts that staff must approve before customers see them.
SCHEME_AUTO_UPDATE=true
SCHEME_UPDATE_INTERVAL_HOURS=24
# llm = extract announcements with Groq (falls back to demo presets on error)
# preset = never call the LLM (useful offline / during a live demo)
SCHEME_EXTRACTION_MODE=llm
