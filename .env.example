# Settings for docker-compose.yml (copy to .env next to it).
# App settings (GROQ_API_KEY, SECRET_KEY, ...) stay in backend/.env.

# Password for the PostgreSQL database — use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Number of API containers (more = more capacity).
API_REPLICAS=2

# Port the web app is published on: http://localhost:8080
WEB_PORT=8080

# Only if Google staff sign-in is used (same value as GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=
