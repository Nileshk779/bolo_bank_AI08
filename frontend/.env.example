# Copy to .env and fill in if you're enabling Google Sign-In for staff.
# Must be the SAME client ID as GOOGLE_CLIENT_ID in backend/.env.
# This value is public (it's sent to the browser) — that's expected for
# Google Identity Services; the actual verification happens server-side,
# and no client *secret* is ever needed on the frontend.
VITE_GOOGLE_CLIENT_ID=
